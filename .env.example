# Home Vision — frontend environment variables
# Copy to .env.local and fill in your project values.
#
# These are PUBLIC values only (the publishable/anon key). They are safe to
# ship to the browser because Row Level Security protects the database.
# NEVER put a service-role or secret key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred name:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Legacy name (still supported by src/lib/supabase.ts):
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
